{
  "name": "@stellar-x402/mcp-local",
  "version": "0.0.0",
  "private": true,
  "description": "Local stdio MCP server for Bazaar search and paid calls with locally held keys",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@stellar-x402/config": "workspace:*",
    "@stellar-x402/mcp": "workspace:*",
    "@x402/stellar": "~2.28.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^16.3.0"
  },
  "bin": {
    "stellar-x402-mcp": "./dist/index.js"
  }
}
