{
  "name": "@stellar-x402/portal",
  "version": "0.0.0",
  "private": true,
  "description": "The portal's backend: a seller's pubnet API key, for the API hub",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@stellar-x402/api-keys": "workspace:*",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1"
  }
}
