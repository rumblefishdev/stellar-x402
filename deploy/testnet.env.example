NETWORK=stellar:testnet
PORT=4021
LOG_LEVEL=info
# Comma-separated, tried in order, at most 3. Defaults to https://soroban-testnet.stellar.org when
# empty, but then failover has nowhere to go: list a second provider (0045)
RPC_URLS=https://soroban-testnet.stellar.org,https://soroban-rpc.testnet.stellar.gateway.fm
# The facilitator key signs in OpenBao Transit (ADR 0013). Local runs: `pnpm dev:openbao` starts a
# fake one and prints these settings (apps/facilitator/README.md). The OpenBao key's own account (G…): the fee account and
# every channel's signer
FACILITATOR_ADDRESS=
# OpenBao's listener socket for this network, the Transit key's name and its pinned version
OPENBAO_SOCKET=
OPENBAO_KEY=
OPENBAO_KEY_VERSION=1
# Files holding the AppRole login; the plain variables are refused
OPENBAO_ROLE_ID_FILE=
OPENBAO_SECRET_ID_FILE=
# Comma-separated channel addresses (G…), never secrets. The service refuses to start unless each
# has its master key at weight 0 and the facilitator key as its only signer
CHANNELS=
# Required. Where the rate limits take the client's IP from: cloudflare (the CF-Connecting-IP header,
# behind Cloudflare Tunnel) or socket (no proxy in front)
CLIENT_IP=cloudflare
# Required. postgres:// URL of the migrated database (`pnpm migrate`); for local runs the repo's
# compose database: postgres://postgres:postgres@127.0.0.1:15432/postgres
DATABASE_URL=
# Spend budgets (0024, facilitator README "Spend budgets and breakers"): fees in stroops per
# rolling window, commented with their defaults. Blank or commented means the default. A known
# asset is USDC; every other token gets the low tier. Each budget must be at least MAX_FEE_STROOPS
# SPEND_WINDOW_MS=86400000
# SPEND_GLOBAL_STROOPS=500000000
# SPEND_PER_PAYER_STROOPS=20000000
# SPEND_PER_PAY_TO_STROOPS=100000000
# SPEND_PER_ASSET_STROOPS=250000000
# SPEND_PER_ASSET_OTHER_STROOPS=20000000
# SPEND_TIER_OTHER_STROOPS=100000000
# /settle refuses while the fee account can spend less than the floor (5 XLM, below ADR 0013's
# alarms at 25 and 10 XLM); its balance is read every SPEND_BALANCE_INTERVAL_MS
# SPEND_FLOOR_STROOPS=50000000
# SPEND_BALANCE_INTERVAL_MS=30000
# UptoProxy for the upto scheme (task 0004): deploy/scripts/deploy-contract.sh upto-proxy
# WASM hash 00a06b1683557a60d2822bbab4e1fee9012e9b521d52b22a8ab22fd47cd4b79c (self-extending,
# allowance expiry capped at a day; task 0035)
UPTO_PROXY_CONTRACT_ID=CAL7SBTOECJ6HXXO3ST43LM2HJJFSZ3ZDEEZBIWHJPB7DRF5MXS5V2VC
