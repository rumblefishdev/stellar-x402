{
  "uid": "x402-facilitator",
  "title": "x402 facilitator",
  "tags": ["x402"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "description": "stellar-x402's facilitator and ch-prod-01, from the monitoring VM's Prometheus (lore 0139). Edited in deploy/metrics/dashboards/, never in Grafana.",
  "links": [
    {
      "title": "Runbook: docs/monitoring.md",
      "type": "link",
      "url": "https://github.com/rumblefishdev/stellar-x402/blob/develop/docs/monitoring.md",
      "targetBlank": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "network",
        "label": "Network",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(settlement_outcomes_total{project=\"x402\",drill=\"\"}, network)",
          "refId": "network"
        },
        "definition": "label_values(settlement_outcomes_total{project=\"x402\",drill=\"\"}, network)",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Now",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Facilitator scraped",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(up{project=\"x402\",job=\"facilitator\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down",
                  "color": "red"
                },
                "1": {
                  "text": "up",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "description": "The agent's last scrape of /metrics on ch-prod-01."
    },
    {
      "type": "stat",
      "title": "Up for",
