#!/bin/sh
# `docker compose` in an environment's project with the facilitator image its `digest` names
# (ADR 0011). Used by x402@<environment> and the deploy; the units that never start the
# facilitator set FACILITATOR_IMAGE themselves.
#   x402-compose <environment> <compose arguments>...
set -eu
cd "/srv/x402/$1"
shift
FACILITATOR_IMAGE="ghcr.io/rumblefishdev/x402-facilitator@$(cat digest)" exec docker compose "$@"
