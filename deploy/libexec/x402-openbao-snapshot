#!/bin/bash
# OpenBao's daily Raft snapshot, sent off the server to our Borg repository on the Storage Box
# (ADR 0013, task 0026). Run as root by x402-openbao-snapshot.timer. It logs in with the
# snapshot-only AppRole, saves a snapshot inside the container, copies it to a tmpfs on the host,
# makes one Borg archive of it, keeps 14 daily archives and touches the stamp 0027's probe reads.
# A run that fails anywhere leaves no stamp, and the snapshot-age alarm fires after 26 hours.
# Overridable for a test or a local run: X402_LOCK, X402_LOCK_WAIT and the paths below.
#   x402-openbao-snapshot
#   x402-openbao-snapshot borg ARGS...   any Borg command on that repository, for an admin: init,
#                                        key export, list, check (runbook, OpenBao snapshots)
#
# The credentials, set up by the runbook (OpenBao snapshots), each a systemd credential in
# /srv/x402/backup/creds: storage-box-ssh-key (the write sub-account's key), borg-passphrase,
# snapshot-role-id and snapshot-secret-id (the AppRole x402-snapshot).
set -euo pipefail

# Overridable for a local run (runbook, OpenBao snapshots, Testing locally).
: "${X402_OPENBAO_DIR:=/srv/x402/openbao}"
: "${X402_STAMPS:=/var/lib/x402/last-ok}"
: "${X402_KNOWN_HOSTS:=/etc/x402/storage-box.known_hosts}"
: "${BORG_REPO:=ssh://u595862-sub2@u595862-sub2.your-storagebox.de:23/./data/openbao}"
# The Borg the Storage Box runs for us, the same major version as the server's package: Hetzner
# keeps several side by side.
: "${BORG_REMOTE_PATH:=borg-1.2}"
: "${BORG_BASE_DIR:=/var/lib/x402/borg}"
: "${X402_LOCK:=/run/lock/x402-openbao-snapshot}"
: "${X402_LOCK_WAIT:=600}"
run=/run/x402/backup
export BORG_REPO BORG_REMOTE_PATH BORG_BASE_DIR

# One run at a time, the timer's and an admin's `borg` alike: they share the decrypted files, the
# snapshot and the container's /tmp/raft.snap, which each run's cleanup deletes. An admin's call
# during the night's run waits for it.
exec 9> "$X402_LOCK"
flock -w "$X402_LOCK_WAIT" 9 || { echo "another snapshot run holds $X402_LOCK" >&2; exit 1; }

# Borg's two, and the AppRole's only for a snapshot: an admin's `borg init` comes before it exists.
creds=(storage-box-ssh-key borg-passphrase)
[ "${1:-}" = borg ] || creds+=(snapshot-role-id snapshot-secret-id)
[ "${X402_CREDS_DIR:-}" ] && run=$X402_CREDS_DIR # a local run: plain files, no systemd-creds
snap=$run/openbao.snap
token=
bao() { docker compose -f "$X402_OPENBAO_DIR/compose.yaml" exec -T -e BAO_TOKEN openbao bao "$@"; }
cleanup() {
  # This host's files first: the two calls after them can hang on a wedged OpenBao or Docker until
  # systemd kills the run, and a kill must not leave the decrypted credentials behind.
  rm -f "$snap"
  if [ -z "${X402_CREDS_DIR:-}" ]; then
    # "$run/.$c": the file x402-creds decrypts into before its mv, left by a decrypt that stopped.
    for c in "${creds[@]}"; do rm -f "$run/$c" "$run/.$c"; done
  fi
  if [ "$token" ]; then BAO_TOKEN=$token bao token revoke -self > /dev/null 2>&1 || :; fi
  docker compose -f "$X402_OPENBAO_DIR/compose.yaml" exec -T openbao rm -f /tmp/raft.snap > /dev/null 2>&1 || :
}
# Before the decrypt: one that fails halfway leaves no file it already wrote.
trap cleanup EXIT
[ "${X402_CREDS_DIR:-}" ] || /usr/local/libexec/x402/x402-creds backup "${creds[@]/%/:0}"

export BORG_PASSCOMMAND="cat $run/borg-passphrase"
export BORG_RSH="ssh -i $run/storage-box-ssh-key -o IdentitiesOnly=yes -o BatchMode=yes \
-o StrictHostKeyChecking=yes -o UserKnownHostsFile=$X402_KNOWN_HOSTS"

if [ "${1:-}" = borg ]; then
  shift
  borg "$@"
  exit
fi

# A run missed while the server was down starts at boot with OpenBao, which may still be unsealing
# or electing itself Raft's leader: wait up to 5 minutes for it. `bao status` exits 2 while sealed,
# and says is_self once this node is the active one.
for i in $(seq 60); do
  bao status -format=json 2> /dev/null | grep -q '"is_self": true' && break
  [ "$i" -lt 60 ] || { echo "OpenBao isn't unsealed and active after 5 minutes" >&2; exit 1; }
  sleep 5
done

# The login's JSON over stdin, so neither ID reaches a command line. Both are UUIDs.
token=$(printf '{"role_id":"%s","secret_id":"%s"}' \
  "$(cat "$run/snapshot-role-id")" "$(cat "$run/snapshot-secret-id")" |
  BAO_TOKEN= bao write -field=token auth/approle/login -)
export BAO_TOKEN=$token

# Saved in the container's /tmp, a tmpfs, then copied to ours: a pipe straight into Borg would
# leave an archive of a partial snapshot if the save failed halfway.
bao operator raft snapshot save /tmp/raft.snap
umask 077
docker compose -f "$X402_OPENBAO_DIR/compose.yaml" exec -T openbao cat /tmp/raft.snap > "$snap"
[ -s "$snap" ] || { echo "the snapshot is empty" >&2; exit 1; }
gzip -t "$snap" || { echo "the snapshot isn't a whole gzip file" >&2; exit 1; }

cd "$run"
borg create --stats "::openbao-{utcnow:%Y-%m-%dT%H:%M:%SZ}" openbao.snap
borg prune --glob-archives 'openbao-*' --keep-daily 14
borg compact

mkdir -p "$X402_STAMPS"
touch "$X402_STAMPS/openbao-snapshot"
echo "snapshot saved, $(stat -c %s "$snap") bytes"
