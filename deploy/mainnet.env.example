NETWORK=stellar:pubnet
PORT=4021
LOG_LEVEL=info
# Required, comma-separated, tried in order: there is no default mainnet RPC
RPC_URLS=
# The facilitator key signs in OpenBao Transit (ADR 0013); pubnet refuses SIGNER=secret.
SIGNER=openbao
# The OpenBao key's own account (G…): the fee account and every channel's signer
FACILITATOR_ADDRESS=
# OpenBao's listener socket for this network, the Transit key's name and its pinned version
OPENBAO_SOCKET=
OPENBAO_KEY=
OPENBAO_KEY_VERSION=1
# The AppRole login, as files (never plain values in production)
OPENBAO_ROLE_ID_FILE=
OPENBAO_SECRET_ID_FILE=
# Comma-separated channel addresses (G…), never secrets. The service refuses to start unless each
# has its master key at weight 0 and the facilitator key as its only signer
CHANNELS=
# Required. Where the rate limits take the client's IP from: cloudflare (the CF-Connecting-IP header,
# behind Cloudflare Tunnel) or socket (no proxy in front). Mainnet's proxy is decided in 0038
CLIENT_IP=
# Required. postgres:// URL of the migrated database (use a secret store in production; never
# logged). Run `pnpm migrate` before each deploy.
DATABASE_URL=
