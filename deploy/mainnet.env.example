NETWORK=stellar:pubnet
PORT=4021
LOG_LEVEL=info
# Required, comma-separated, tried in order: there is no default mainnet RPC
RPC_URLS=
# The facilitator key (S…): signs for every channel and pays the fee bumps. Never logged; use a
# secret store in production
FACILITATOR_SECRET=
# Comma-separated channel addresses (G…), never secrets. The service refuses to start unless each
# has its master key at weight 0 and the facilitator key as its only signer
CHANNELS=
# Required. Where the rate limits take the client's IP from: the header the proxy in front sets on
# every request (cf-connecting-ip behind Cloudflare; mainnet's proxy is decided in 0038)
CLIENT_IP_HEADER=
# Required outside testnet: settlements must survive restarts. Run `pnpm migrate` before each deploy.
STORE=postgres
# postgres:// URL of the migrated database (use a secret store in production; never logged)
DATABASE_URL=
