# Testnet's PostgreSQL in an environment (ADR 0011): x402-db-testnet@production. A template per
# network, so %i is the environment as in every other unit. Deploys never restart it.
[Unit]
Description=x402 testnet PostgreSQL (%i)
Documentation=https://github.com/rumblefishdev/stellar-x402/blob/develop/docs/adr/0011-facilitator-hosting.md
PartOf=docker.service
After=docker.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
WorkingDirectory=/srv/x402/%i
# Compose reads the whole file; this unit never starts the facilitator.
Environment=FACILITATOR_IMAGE=unused
ExecStartPre=/usr/local/libexec/x402/x402-creds %i postgres-password.testnet:999
ExecStart=/usr/bin/docker compose up --no-deps --exit-code-from postgres-testnet postgres-testnet
# Started means accepting connections, so the units after this one find it up.
ExecStartPost=/usr/bin/timeout 50 /bin/sh -c 'until docker compose exec -T postgres-testnet pg_isready --quiet; do sleep 1; done'
ExecStop=/usr/bin/docker compose stop postgres-testnet
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
# Above Postgres's 120 s stop_grace_period.
TimeoutStopSec=150

[Install]
WantedBy=multi-user.target
