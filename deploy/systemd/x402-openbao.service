# OpenBao, which holds the facilitator key of every network (ADR 0013): one per server, its own
# project in /srv/x402/openbao. It unseals itself with the seal key this unit decrypts. Deploys
# never restart it, and the facilitator starts and answers /verify without it.
[Unit]
Description=x402 OpenBao
Documentation=https://github.com/rumblefishdev/stellar-x402/blob/develop/docs/adr/0013-facilitator-key-custody.md
PartOf=docker.service
After=docker.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
WorkingDirectory=/srv/x402/openbao
# OpenBao's server log, stdout and stderr in order, for the CloudWatch agent (0027 decision 1).
# One OpenBao serves every environment; its file ships with production's.
StandardOutput=append:/var/log/x402/openbao/openbao.log
StandardError=inherit
ExecStartPre=/usr/local/libexec/x402/x402-creds openbao seal-key:100
ExecStart=/usr/bin/docker compose up --no-log-prefix --no-color --no-deps --exit-code-from openbao openbao
# Started means testnet's socket exists, so x402@ mounts a volume that has it. Quiet: an Exec line
# that prints into a full disk fails the start.
ExecStartPost=/usr/bin/timeout 50 /bin/sh -c 'until docker compose exec -T openbao test -S /run/openbao/testnet/bao.sock > /dev/null 2>&1; do sleep 1; done'
ExecStop=/usr/bin/docker compose stop openbao
Restart=on-failure
RestartSec=5
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
