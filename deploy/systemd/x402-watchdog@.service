# One pass of the facilitator's watchdog (ADR 0011), started by x402-watchdog@<environment>.timer.
[Unit]
Description=x402 facilitator watchdog (%i)
Documentation=https://github.com/rumblefishdev/stellar-x402/blob/develop/docs/adr/0011-facilitator-hosting.md
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/x402/x402-watchdog %i
# Above its 10 s stop and x402@'s start (60 s), so a wedged docker or systemctl ends the pass
# instead of every later one waiting behind it.
TimeoutStartSec=5min
