# A fresh 12-hour session for the CloudWatch agent every hour (lore 0027 decision 46). The agent
# starts the service at boot itself; this timer starts in the runbook's admin step, once the
# certificate is on the server.
[Unit]
Description=x402 CloudWatch agent credentials, every hour
Documentation=https://github.com/rumblefishdev/stellar-x402/blob/develop/docs/runbook.md

[Timer]
OnCalendar=hourly
AccuracySec=1s

[Install]
WantedBy=timers.target
