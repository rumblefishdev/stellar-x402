# The CloudWatch agent's AWS credentials, from IAM Roles Anywhere (lore 0027 decision 46): one
# `aws_signing_helper update --once` a run, started by the agent at boot and by
# x402-cloudwatch-credentials.timer every hour. Each run asks for a 12-hour session, so the file
# always holds keys with about 11 hours left, and the agent ships through a Roles Anywhere outage
# that long. Only the agent reads the file; nothing else on the server holds AWS credentials.
[Unit]
Description=x402 CloudWatch agent credentials, from IAM Roles Anywhere
Documentation=https://github.com/rumblefishdev/stellar-x402/blob/develop/docs/runbook.md
Wants=network-online.target
After=network-online.target
# Restart= is its retry: a burst of failed runs is never refused.
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=cwagent
Group=cwagent
# The key decrypted for this run only, readable by cwagent, removed when it ends.
LoadCredentialEncrypted=cloudwatch-agent-key:/srv/x402/production/creds/cloudwatch-agent-key.cred
# Kept between runs: `restart` or the default would remove the keys after each one. No
# RemainAfterExit=: the hourly start would then find the unit active and do nothing.
RuntimeDirectory=x402-cloudwatch
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
# TRUST_ANCHOR_ARN, PROFILE_ARN and ROLE_ARN, written by the playbook from inventory.ini.
EnvironmentFile=/etc/x402/cloudwatch-credentials.env
Environment=AWS_SHARED_CREDENTIALS_FILE=/run/x402-cloudwatch/credentials
Environment=AWS_CONFIG_FILE=/dev/null
# The standard regional endpoint: the dual-stack one has an AAAA record, and IPv6 leaves from an
# address the role's aws:SourceIp refuses. The default session is an hour, hence the duration.
# Never --debug, which logs the response, keys included.
ExecStart=/usr/local/bin/aws_signing_helper update --once \
  --profile AmazonCloudWatchAgent \
  --certificate /srv/x402/production/cloudwatch-agent.crt \
  --private-key %d/cloudwatch-agent-key \
  --trust-anchor-arn ${TRUST_ANCHOR_ARN} \
  --profile-arn ${PROFILE_ARN} \
  --role-arn ${ROLE_ARN} \
  --session-duration 43200 \
  --endpoint https://rolesanywhere.eu-central-1.amazonaws.com
TimeoutStartSec=60
Restart=on-failure
RestartSec=60s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
# No AF_INET6: an endpoint that gains an AAAA record can't take the helper onto IPv6.
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK
SystemCallArchitectures=native
